# Loora local-first environment. Copy to `.env` for development.
# Nothing here is a secret for anyone but this machine.

# SQLite file. Defaults to ./data/loora.db (dev) — the desktop app passes its
# own app-data path to the sidecar it spawns. Use :memory: for tests.
LOORA_SQLITE_PATH=./data/loora.db

# Local server port (oRPC + MCP on one process). The desktop host proxies
# /api/* there and MCP clients use http://127.0.0.1:<port>/mcp.
LOORA_MCP_PORT=4100
MCP_PUBLIC_URL=http://localhost:4100

# Signs agent-handoff tokens. The desktop sidecar generates and persists its
# own key in the data dir; set this only to share handoffs across processes.
LOORA_HANDOFF_SECRET=

# Optional Redis for API rate-limit counters. Unset falls back to in-process
# memory limits.
REDIS_URL=

# Desktop host (only what the Tauri process reads):
# LOORA_API_ORIGIN=http://127.0.0.1:4100
# LOORA_DATA_DIR= (defaults to the OS app-data dir)
# LOORA_SERVER_BIN= (defaults to the bundled sidecar; dev: run `bun run dev`)
# LOORA_DESKTOP_PORT=4300
# LOORA_DESKTOP_APP_PORT=1421
# VITE_LOORA_APP_ORIGIN=http://127.0.0.1:4100

# Asset bucket (S3-compatible). Unset keeps image bytes as base64 in SQLite.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_PUBLIC_URL=

# Screenshots render with Playwright Chromium. Point at a system install to
# skip the download, or leave unset.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
MCP_SCREENSHOT_CONCURRENCY=1
MCP_SCREENSHOT_QUEUE_LIMIT=2
MCP_SCREENSHOT_QUEUE_TIMEOUT_MS=20000
MCP_SCREENSHOT_IDLE_TIMEOUT_MS=60000

# Opt-in JSON request timing logs (`api.request` console.info lines).
LOG_REQUEST_TIMING=false
