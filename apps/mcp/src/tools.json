        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "insertIcon",
    "description": "Insert a library icon as an editable svg node (tagged data-icon-library / data-icon-name). Color sets the svg color style, size sets width and height, strokeWidth sets the outline weight. Restyle later with styleIcon. Defaults to the first root as parent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Design id"
        },
        "draftId": {
          "description": "Branch target; omit for Main",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "library": {
          "type": "string",
          "enum": [
            "hugeicons",
            "lucide"
          ],
          "description": "Icon set: hugeicons or lucide"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Icon name from searchIcons"
        },
        "parentId": {
          "description": "Element to insert into; defaults to the page root",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pageId": {
          "description": "Page to insert into (the pageId from createPage or listPages); defaults to the first page. Ignored when parentId is given.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "color": {
          "description": "Any CSS color; icons draw in currentColor",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "size": {
          "description": "Width and height in px",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2048
        },
        "strokeWidth": {
          "description": "Outline weight in the 24px viewBox",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        }
      },
      "required": [
        "designId",
        "library",
        "name"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "styleIcon",
    "description": "Restyle an icon inserted with insertIcon: color, size (px) and strokeWidth in one atomic edit. Only the fields you pass change.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Design id"
        },
        "draftId": {
          "description": "Branch target; omit for Main",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The icon svg node id returned by insertIcon"
        },
        "color": {
          "description": "Any CSS color; icons draw in currentColor",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "size": {
          "description": "Width and height in px",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2048
        },
        "strokeWidth": {
          "description": "Outline weight in the 24px viewBox",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        }
      },
      "required": [
        "designId",
        "nodeId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "listPages",
    "description": "List a design's pages. Each page is an isolated canvas with its own layers and size. pageId is the page root node id (use it as parentId, and as rootId for getWebScreenshot or exportDesign); null is the original unnamed page.",
