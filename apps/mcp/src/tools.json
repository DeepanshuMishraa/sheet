[
  {
    "name": "getUsage",
    "description": "Read MCP tool call usage. Local-first: usage is unlimited, this status check never consumes anything.",
    "inputSchema": {
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "listDesigns",
    "description": "Start here. List the local Sheet designs and canonical editor URLs.",
    "inputSchema": {
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "getWebDocument",
    "description": "Read a web-native design document: DOM nodes and roots, authored stylesheets and rules with media/container/supports conditions, components, and instances with bindings and overrides. Returns the revision for optimistic concurrency. This is authored source of truth; computed styles are never stored.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Design id"
        }
      },
      "required": [
        "designId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "getWebHTML",
    "description": "Serialize a web-native document to HTML. Direct serialization of the authored DOM; no translation layer.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Design id"
        }
      },
      "required": [
        "designId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "getWebCSS",
    "description": "Serialize a web-native document to authored CSS stylesheets. Direct serialization of the authored rules in cascade order; computed values never appear.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Design id"
        }
      },
      "required": [
        "designId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "applyWebTransaction",
    "description": "Mutate a web-native document with one validated WebTransaction: the same operation vocabulary, validation, undo inverses, revision compare-and-swap, history, and realtime path the editor uses. Operations: node.insert/node.patch/node.move/node.delete, stylesheet.insert/stylesheet.patch/stylesheet.delete, rule.insert/rule.patch/rule.move/rule.delete, component.define/component.delete, instance.create/instance.delete/instance.setOverride/instance.clearOverride. To resize the page, node.patch the root element width and height, for example 1440px by 2400px. Rules: patching a bound instance node directly is rejected (use instance.setOverride with text, attributes, or --custom-properties); template edits propagate to instances automatically; component CSS reaches instances through the normal cascade. Stale expectedRevision returns applied:false with reason stale instead of overwriting.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Design id"
        },
        "draftId": {
          "description": "Branch target; omit for Main. Draft writes require an active branch.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Revision from getWebDocument; the write fails stale when it moved."
        },
        "transaction": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Stable idempotency id; retries reuse it."
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Human-readable label for history."
            },
            "operations": {
              "minItems": 1,
              "maxItems": 2000,
              "type": "array",
              "items": {},
              "description": "WebOperations validated exactly like editor transactions."
            }
          },
          "required": [
            "id",
            "label",
            "operations"
          ],
          "description": "One atomic batch; applied fully or not at all."
        }
      },
      "required": [
        "designId",
        "expectedRevision",
        "transaction"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "getWebScreenshot",
    "description": "Render a real PNG of a web-native document with the same standalone HTML/CSS serialization the editor materializes. Call this after meaningful edits to verify the visual result. Read-only: revisions, history, and the document are untouched.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Design id"
        },
        "rootId": {
          "description": "Web node id to capture; omit for the whole document.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "width": {
          "default": 1440,
          "type": "number",
          "minimum": 200,
          "maximum": 3840
        },
        "pixelRatio": {
          "default": 1,
          "type": "number",
          "minimum": 1,
          "maximum": 2
        }
      },
      "required": [
        "designId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "exportDesign",
    "description": "Export a design. format \"html\" returns the complete self-contained page (all DOM and CSS in one file, ready to save as .html); \"png\"/\"jpg\" return a rendered image as base64; \"json\" returns the authored web document. The result carries filename, mimeType, encoding (\"utf8\" or \"base64\") and data.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Design id"
        },
        "format": {
          "type": "string",
          "enum": [
            "html",
            "png",
            "jpg",
            "json"
          ],
          "description": "html: one complete self-contained page (DOM + all CSS). png/jpg: rendered image. json: the authored web document."
        },
        "rootId": {
          "description": "png/jpg only: web node id to capture; omit for the whole document.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "width": {
          "default": 1440,
          "description": "png/jpg only: viewport width in px.",
          "type": "number",
          "minimum": 200,
          "maximum": 3840
        },
        "pixelRatio": {
          "default": 1,
          "description": "png/jpg only: device scale factor.",
          "type": "number",
          "minimum": 1,
          "maximum": 2
        }
      },
      "required": [
        "designId",
        "format"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
