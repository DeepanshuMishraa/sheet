{
  "name": "@sheet/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "bun run drizzle-kit generate && bun run embed",
    "embed": "bun run scripts/embed-migrations.ts",
    "migrate": "bun run src/migrate.ts",
    "studio": "bun run drizzle-kit studio"
  },
  "dependencies": {
    "@sheet/canvas": "workspace:*",
    "@sheet/realtime": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "drizzle-kit": "^0.31.10"
  }
}
